		(uuid "dda7f110-40b9-4edb-905f-1a07db0e602c")
	)
	(text "Powered from the XIAO's own USB-C port (no board power input).\nESP_TX = D4 / GPIO22 (uart_tx_pin)\nESP_RX = D10 / GPIO18 (uart_rx_pin)\n\nUnderside pads 24-33 (MTDI, MTDO, EN, GND, MTMS, MTCK,\nBOOT, 3V3, BAT, GND) are not soldered and are omitted from\nthis symbol. The PCB footprint marks them with no-via keep-outs."
		(exclude_from_sim no)
		(at 25.4 106.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "effb2aec-1f7a-44a4-8fe7-56eab6d113c1")
	)
